{
  "name": "obie-rotator",
  "version": "0.1.0",
  "description": "Slack rotation bot for Obie workspace",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "start": "node dist/index.js",
    "db:reset": "rm -f data/rotator.db"
  },
  "dependencies": {
    "@slack/bolt": "^3.19.0",
    "cron-parser": "^5.10.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
